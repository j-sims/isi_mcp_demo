# isi_mcp application configuration (non-secret defaults)
# To enable OAuth: set SSL=true and AUTH_ENABLED=true, then restart with ./start.sh
# (which will prompt for Keycloak passwords). Auth requires SSL=true.

VAULT_FILE=/app/vault/vault.yml

# External port clients connect to (HTTP direct when SSL=false, HTTPS via nginx when SSL=true).
PORT=80
SSL=false

AUTH_ENABLED=false
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=powerscale
# MCP_PUBLIC_URL: public base URL clients use to reach this server.
# Used only when AUTH_ENABLED=true — must match the client-facing URL.
# Set to https://localhost (SSL=true) or http://localhost:<PORT> (SSL=false with a custom port).
# Authentication requires SSL=true; see docs/install.md#enabling-authentication-optional.
MCP_PUBLIC_URL=https://localhost

# Audit log settings
MAX_AUDIT_LOGFILE_SIZE=10485760
MAX_AUDIT_LOGFILE_COUNT=10
